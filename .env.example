# ═══════════════════════════════════════════════════════════════════
# .env.example —— 环境变量模板（进 git，作为参考）
#
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ═══ 数据库 ═══
# 全部为 DB_ 通用前缀，不绑定 postgres；换库时只改 docker-compose 桥接行
DB_NAME=damon
DB_USER=damon
DB_PASSWORD=12345678

# ═══ 加密 ═══
# 必须 ≥32 字符，生产环境务必替换为强随机值
MASTER_KEY=jHn2_hddnHpkZ5yX7rljnt3YdFLt27jKwoj0GFJLHJQ

# ═══ 推理后端 ═══
# vllm / sglang（预留）
INFERENCE_SERVER=vllm
# 网关地址（必填，无默认值；Docker Compose 已显式注入）
INFERENCE_GATEWAY_URL=http://model-gateway:8080/v1
# 推理客户端网络超时在 app/config/ai/inference/inference-config.yaml 配置
# 各角色 api_key 映射 JSON（必须覆盖 inference-config.yaml 的 roles 段全部角色）
# 单个角色也可用 INFERENCE_API_KEY_{ROLE} 单独指定，优先级高于 JSON
# INFERENCE_API_KEYS={"inference":"ak_inference_001","summary":"ak_inference_002","guardrail":"ak_guardrail"}

# ═══ 日志级别 ═══
# debug / release（可选，默认 debug；生产镜像由 SERVER_BUILD_ENV 固化后此项被忽略）
# APP_ENV=debug
# 日志级别（可选，默认 INFO）
LOG_LEVEL=INFO

# ═══ 构建模式 ═══
# 0 = 锁定 release（生产流水线）
# 1 = 默认 debug，APP_ENV 可覆盖（开发/预发）
SERVER_BUILD_ENV=1
FRONTEND_BUILD_ENV=1

# ═══ 数据存储 ═══
# 宿主机数据根目录（volumes 挂载的根路径）
DATA_DIR=/home/jason/damon

# ═══ Docker 代理网络 ═══
# web-app 与 app-server 专用网络；请确保不与服务器现有 Docker、局域网或 VPN 网段冲突
PROXY_NETWORK_SUBNET=172.30.20.0/24

# ═══ CORS ═══
# Release 模式的允许来源（逗号分隔）
CORS_ORIGINS=https://your-production-domain.com

# Container path for locally cached AI models
MODEL_ROOT_DIR=/models

# Container name and matching in-container application directory.
# Keep this aligned with app-server/Dockerfile's WORKDIR.
APP_NAME=app-server
