# ═══════════════════════════════════════════════════════════════════
# .env.example —— 环境变量模板（进 git，作为参考）
#
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ═══ 数据库 ═══
# 全部为 DB_ 通用前缀，不绑定 postgres；换库时只改 docker-compose 桥接行
DB_NAME=damon
DB_USER=postgres
DB_PASSWORD=changeme

# ═══ 加密 ═══
# 必须 ≥32 字符，生产环境务必替换为强随机值
MASTER_KEY=changeme-32-char-minimum-master-key

# ═══ 推理后端 ═══
# ollama / vllm / sglang
INFERENCE_SERVER=ollama

# ═══ 构建模式 ═══
# 0 = 锁定 release（生产流水线）
# 1 = 默认 debug，APP_ENV 可覆盖（开发/预发）
SERVER_BUILD_ENV=0
FRONTEND_BUILD_ENV=0

# ═══ 数据存储 ═══
# 宿主机数据根目录（volumes 挂载的根路径）
DATA_DIR=/root/damon

# ═══ CORS ═══
# Release 模式的允许来源（逗号分隔）
CORS_ORIGINS=https://your-production-domain.com
