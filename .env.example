# ═══════════════════════════════════════════════════════════════════
# .env.example —— 环境变量模板（进 git，作为参考）
#
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ═══ 数据库 ═══
# 全部为 DB_ 通用前缀，不绑定 postgres；换库时只改 docker-compose 桥接行
DB_NAME=damon
DB_USER=damon
DB_PASSWORD=changeme

# ═══ 加密 ═══
# 必须 ≥32 字符，生产环境务必替换为强随机值
MASTER_KEY=O_dRX5hdQXO4vVi6kYECDjB7tlo9rQjAV9PPjguUh-4

# ═══ 推理后端 ═══
# ollama / vllm / sglang
INFERENCE_SERVER=ollama
# 网关地址（必填，无默认值；Docker Compose 已显式注入）
INFERENCE_GATEWAY_URL=http://inference-gateway:8080/v1
# 推理客户端网络超时在 app/config/rag/rag-runtime.yaml 的 rag.transport.inference.timeout_seconds 配置
# 各角色 api_key 映射 JSON（必须覆盖 rag-runtime.yaml 的 rag.roles 段全部角色）
# 单个角色也可用 INFERENCE_API_KEY_{ROLE} 单独指定，优先级高于 JSON
# INFERENCE_API_KEYS={"inference":"ak_pool_001","intent":"ak_pool_002","rewrite":"ak_pool_003","summary":"ak_pool_004","guardrail":"ak_pool_005"}

# ═══ 日志级别 ═══
# debug / release（可选，默认 debug；生产镜像由 SERVER_BUILD_ENV 固化后此项被忽略）
# APP_ENV=debug
# 日志级别（可选，默认 INFO）
LOG_LEVEL=INFO

# ═══ 构建模式 ═══
# 0 = 锁定 release（生产流水线）
# 1 = 默认 debug，APP_ENV 可覆盖（开发/预发）
SERVER_BUILD_ENV=0
FRONTEND_BUILD_ENV=0

# ═══ 数据存储 ═══
# 宿主机数据根目录（volumes 挂载的根路径）
DATA_DIR=/root/damon

# ═══ CORS ═══
# Release 模式的允许来源（逗号分隔）
CORS_ORIGINS=https://your-production-domain.com
